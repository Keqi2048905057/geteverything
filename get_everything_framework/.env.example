# ========================
# LLM / Agent 配置
# ========================

LLM_PROVIDER=deepseek
LLM_MODEL_ID=deepseek-chat
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_JSON_MODE=false

# ========================
# 外部 API / 搜索引擎
# ========================

FOFA_BASE_URL=https://fofa.info/api/v1/search/all
FOFA_EMAIL=
FOFA_KEY=

HUNTER_API_KEY=

QUAKE_API_KEY=

SHODAN_API_KEY=

# ========================
# ENScan 配置
# ========================

# enscan Cookie 配置文件路径 (留空自动检测: %GOPATH%/bin/config.yaml → ~/.config/enscan/config.yaml)
# ENSCAN_CONFIG_PATH=

# ========================
# 字典（wordlist）路径
# ========================
# 默认值是**仓库相对路径**，按项目根（config.py 所在目录）解析，与当前工作目录无关。
# 字典不随仓库分发（见 README「字典不再随仓库分发」）：把 SecLists 放到 SecLists/ 下，
# 或用下面两个变量指向你本机已有的字典（绝对路径同样可用）。
# 配置写了字典但文件不存在时，任务会以 error_code=config_error 失败，
# 而不是静默返回空结果。
# SHUFFLEDNS_WORDLIST=SecLists/subdomains-top1million-5000.txt
# FEROXBUSTER_WORDLIST=SecLists/raft-small-directories.txt

# ========================
# Flask / 安全
# ========================

# 会话签名密钥：务必改成随机值，禁止使用 dev-secret-key。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key

# 本地管理员 Token（本机联调版登录凭据）
# 留空时：服务启动会在控制台打印一个仅本次进程有效的临时 Token。
# 固定下来则填写随机值，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
LOCAL_ADMIN_TOKEN=

# Web 服务绑定（本机联调版默认只监听 127.0.0.1，且关闭 debug）
WEB_HOST=127.0.0.1
WEB_PORT=5000
WEB_DEBUG=false
WEB_THREADS=8

# 真实外部扫描总开关：默认关闭。
# 只有显式设为 true 时才允许 mode=real，且目标仍必须落在已创建的 Scope 内。
GEF_ALLOW_REAL_SCAN=false

# ========================
# 结构化日志（方案第 19 节）
# ========================

# 日志级别：CRITICAL / ERROR / WARNING / INFO / DEBUG（非法值退化为 INFO）。
GEF_LOG_LEVEL=INFO

# 日志格式：
#   json —— 一行一个 JSON 事件，便于 grep / jq / 采集（默认）；
#   text —— key=value 一行，人读更顺。
# 每条事件都带 ts / level / event，以及当前执行流的
# request_id / job_id / step_id / worker_id（有则带，无则省）。
# 密钥、密码、token 一律打码；容器类字段最多记 20 项
# （方案第 19 节：不要把完整目标列表写进公共日志，完整内容请落 artifact）。
GEF_LOG_FORMAT=json
